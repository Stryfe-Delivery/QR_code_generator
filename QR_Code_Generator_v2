<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="author" content="Lucky Hawthorne">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>QR Code Generator v2</title>
<style>
  :root{
    --bg:#0e1116; --card:#161a22; --line:#252b36; --text:#e7ebf2; --muted:#98a2b3;
    --accent:#4f8cff; --accent2:#2f6fe0; --danger:#ff6b6b; --ok:#38d39f; --warn:#ffc857;
  }
  *{box-sizing:border-box}
  body{
    margin:0; background:var(--bg); color:var(--text); min-height:100vh;
    font:15px/1.55 system-ui,-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
  }
  .wrap{max-width:1120px;margin:0 auto;padding:28px 20px 60px}
  header h1{margin:0 0 4px;font-size:24px;letter-spacing:-.02em}
  header .sub{margin:0 0 24px;color:var(--muted);font-size:14px}
  main{display:grid;gap:18px;grid-template-columns:1fr 1fr;align-items:start}
  @media (max-width:820px){ main{grid-template-columns:1fr} }
  .col{display:flex;flex-direction:column;gap:18px}
  .card{
    background:var(--card); border:1px solid var(--line); border-radius:14px;
    padding:18px; display:flex; flex-direction:column; gap:16px;
  }
  .card h2{margin:0;font-size:13px;text-transform:uppercase;letter-spacing:.09em;color:var(--muted);font-weight:600}
  .field{display:flex;flex-direction:column;gap:7px}
  label{font-size:13px;font-weight:600;color:#c8d0dc}
  textarea,select{
    width:100%; background:#0d1117; color:var(--text); border:1px solid var(--line);
    border-radius:9px; padding:10px 12px; font:inherit; outline:none;
  }
  textarea{resize:vertical;min-height:74px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:14px}
  textarea:focus,select:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(79,140,255,.15)}
  .seg{display:flex;gap:6px;background:#0d1117;padding:5px;border-radius:10px;border:1px solid var(--line)}
  .seg button{
    flex:1; background:transparent; border:0; color:var(--muted); padding:8px 6px;
    border-radius:7px; font:inherit; font-weight:600; font-size:13px; cursor:pointer; transition:.15s;
  }
  .seg button:hover{color:var(--text)}
  .seg button.active{background:var(--accent); color:#fff}
  .radios{display:flex;gap:0;background:#0d1117;padding:5px;border-radius:10px;border:1px solid var(--line)}
  .radio{flex:1;position:relative;display:block;cursor:pointer;margin:0}
  .radio input{position:absolute;opacity:0;pointer-events:none}
  .radio span{
    display:block; padding:9px 6px; border-radius:7px;
    font-weight:600; font-size:13px; color:var(--muted);
    text-align:center; transition:.15s;
  }
  .radio input:checked + span{background:var(--accent); color:#fff}
  .radio:hover input:not(:checked) + span{color:var(--text)}
  .radio input:focus-visible + span{outline:2px solid var(--accent);outline-offset:2px}
  .check{display:flex;align-items:center;gap:8px;cursor:pointer;font-size:13px;color:#c8d0dc;font-weight:600}
  .check input{width:16px;height:16px;accent-color:var(--accent);cursor:pointer;margin:0}
  .help{margin:0;font-size:12.5px;color:var(--muted)}
  .meter{font-size:12.5px;color:var(--muted);font-variant-numeric:tabular-nums}
  .meter.over{color:var(--danger)}
  .note{font-size:12.5px;color:var(--warn);min-height:0;opacity:0;transition:opacity .2s;font-variant-numeric:tabular-nums}
  .note.show{opacity:1;min-height:18px}
  .status{font-size:13.5px;border-radius:9px;padding:10px 12px;border:1px solid transparent;display:none}
  .status.show{display:block}
  .status.err{background:rgba(255,107,107,.09);border-color:rgba(255,107,107,.35);color:#ffb3b3}
  .status.ok{background:rgba(56,211,159,.08);border-color:rgba(56,211,159,.3);color:#9beccd}
  .status.warn{background:rgba(255,200,87,.08);border-color:rgba(255,200,87,.3);color:#ffe0a1}
  .preview{display:flex;align-items:center;justify-content:center;background:#fff;border-radius:12px;padding:14px;min-height:280px;transition:background .15s}
  .preview canvas{max-width:100%;height:auto;image-rendering:pixelated;display:block;background:#fff}
  .preview.transparent canvas{
    background-color:#fff;
    background-image:
      linear-gradient(45deg,#d6dae0 25%,transparent 25%),
      linear-gradient(-45deg,#d6dae0 25%,transparent 25%),
      linear-gradient(45deg,transparent 75%,#d6dae0 75%),
      linear-gradient(-45deg,transparent 75%,#d6dae0 75%);
    background-size:16px 16px;
    background-position:0 0, 0 8px, 8px -8px, -8px 0;
  }
  .meta{font-size:12.5px;color:var(--muted);font-variant-numeric:tabular-nums;min-height:18px}
  .row{display:flex;gap:10px;flex-wrap:wrap}
  .row>*{flex:1;min-width:0}
  .btn{
    background:#1e2530; color:var(--text); border:1px solid var(--line); border-radius:10px;
    padding:11px 14px; font:inherit; font-weight:600; font-size:13.5px; cursor:pointer; transition:.15s;
    display:flex; align-items:center; justify-content:center; gap:8px;
  }
  .btn:hover:not(:disabled){background:#26303d;border-color:#39424f}
  .btn:disabled{opacity:.35;cursor:not-allowed}
  .btn .dim{color:var(--muted);font-weight:500;font-size:12px}
  .dl-btn{flex-direction:column;gap:3px;padding:16px 12px}
  .dl-btn .dl-title{font-size:14px}
  .dl-btn .dim{font-size:11.5px;letter-spacing:.02em}
  .svg-btn{flex-direction:column;gap:3px;padding:16px 12px;background:#232b39;border-color:#313b4a}
  .svg-btn:hover:not(:disabled){background:#2b3545;border-color:#3c4658}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <h1>QR Code Generator</h1>
    <p class="sub">Everything runs locally in your browser — nothing is uploaded.</p>
  </header>

  <main>
    <div class="col">
      <!-- ── 1 · Content ─────────────────────────────────────── -->
      <section class="card">
        <h2>1 · Content</h2>

        <div class="field">
          <label>Data type</label>
          <div class="seg" id="typeSeg">
            <button type="button" data-type="numeric" class="active">Numeric</button>
            <button type="button" data-type="url">URL</button>
            <button type="button" data-type="alnum">Alphanumeric</button>
          </div>
          <p class="help" id="typeHelp"></p>
        </div>

        <div class="field">
          <label for="content">Content</label>
          <textarea id="content" rows="3" spellcheck="false" autocomplete="off"
                    placeholder="Enter digits, e.g. 1234-5678_90"></textarea>
          <div class="meter"><span id="count">0</span> / <span id="limit">—</span> characters</div>
          <div class="note" id="normalizeNote"></div>
        </div>

        <div class="field">
          <label class="check">
            <input type="checkbox" id="normalize" checked>
            <span>Normalize whitespace</span>
          </label>
          <p class="help">Trim edges, convert Unicode spaces and tabs to regular spaces, remove zero-width characters.</p>
        </div>

        <div class="field">
          <label for="ec">Error correction level</label>
          <select id="ec">
            <option value="L">L — 7% recoverable</option>
            <option value="M" selected>M — 15% recoverable (recommended)</option>
            <option value="Q">Q — 25% recoverable</option>
            <option value="H">H — 30% recoverable</option>
          </select>
          <p class="help">Higher levels survive more damage but hold less data.</p>
        </div>

        <div class="status" id="status"></div>
      </section>

      <!-- ── 3 · Download ────────────────────────────────────── -->
      <section class="card">
        <h2>3 · Download</h2>

        <div class="field">
          <label>Background</label>
          <div class="radios" role="radiogroup" aria-label="Background">
            <label class="radio">
              <input type="radio" name="bg" value="white" checked>
              <span>White</span>
            </label>
            <label class="radio">
              <input type="radio" name="bg" value="transparent">
              <span>Transparent</span>
            </label>
          </div>
        </div>

        <div class="row">
          <button class="btn dl-btn" id="dlSmall">
            <span class="dl-title">Small PNG</span>
            <span class="dim">256 × 256 px</span>
          </button>
          <button class="btn dl-btn" id="dlLarge">
            <span class="dl-title">Large PNG</span>
            <span class="dim">1024 × 1024 px</span>
          </button>
        </div>

        <button class="btn svg-btn" id="dlSvg">
          <span class="dl-title">SVG</span>
          <span class="dim">Vector — scales to any size</span>
        </button>

        <p class="help">PNGs are square with a 4-module quiet zone. The SVG uses a viewBox in module units, so it stays sharp at any size and can be edited as text.</p>
      </section>
    </div>

    <!-- ── 2 · Preview ────────────────────────────────────────── -->
    <section class="card">
      <h2>2 · Preview</h2>
      <div class="preview" id="preview"><canvas id="canvas" width="300" height="300"></canvas></div>
      <div class="meta" id="meta"></div>
    </section>
  </main>
</div>

<script>
(function () {
'use strict';

/* ═══════════════════════════════════════════════════════════════
   GALOIS FIELD GF(256)
   ═══════════════════════════════════════════════════════════════ */
const GF_EXP = new Uint8Array(512);
const GF_LOG = new Uint8Array(256);
(function initGF() {
  let x = 1;
  for (let i = 0; i < 255; i++) {
    GF_EXP[i] = x;
    GF_LOG[x] = i;
    x <<= 1;
    if (x & 0x100) x ^= 0x11d;
  }
  for (let i = 255; i < 512; i++) GF_EXP[i] = GF_EXP[i - 255];
})();

function gfMul(a, b) {
  if (a === 0 || b === 0) return 0;
  return GF_EXP[GF_LOG[a] + GF_LOG[b]];
}

const RS_GEN_CACHE = Object.create(null);
function rsGenPoly(n) {
  if (RS_GEN_CACHE[n]) return RS_GEN_CACHE[n];
  let poly = [1];
  for (let i = 0; i < n; i++) {
    const a = GF_EXP[i];
    const next = new Array(poly.length + 1).fill(0);
    for (let j = 0; j < poly.length; j++) {
      next[j]     ^= poly[j];
      next[j + 1] ^= gfMul(poly[j], a);
    }
    poly = next;
  }
  return (RS_GEN_CACHE[n] = poly);
}

function rsEncode(dataBytes, ecCount) {
  const gen = rsGenPoly(ecCount);
  const res = dataBytes.concat(new Array(ecCount).fill(0));
  for (let i = 0; i < dataBytes.length; i++) {
    const coef = res[i];
    if (coef !== 0) {
      for (let j = 0; j < gen.length; j++) {
        res[i + j] ^= gfMul(gen[j], coef);
      }
    }
  }
  return res.slice(dataBytes.length);
}

/* ═══════════════════════════════════════════════════════════════
   SPEC TABLES
   ═══════════════════════════════════════════════════════════════ */
const RS_BLOCKS_FLAT = [
